{
  "name": "nuxt_scaffolding",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "deps:check": "depcruise app server shared --config .dependency-cruiser.cjs",
    "dup:check": "jscpd app server shared",
    "unused:check": "knip",
    "test": "vitest",
    "test:unit": "vitest run --project unit --project nuxt",
    "test:arch": "vitest run --project arch",
    "test:coverage": "vitest run --project unit --project nuxt --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load:smoke": "k6 run test/load/smoke.js",
    "test:load": "k6 run test/load/load.js",
    "audit:check": "node scripts/audit-check.mjs",
    "secrets:check": "secretlint \"**/*\"",
    "api:generate": "orval && prettier --write shared/http",
    "check": "run-s typecheck lint format:check",
    "quality": "run-s format:check lint typecheck deps:check dup:check unused:check test:arch test:coverage build audit:check secrets:check test:e2e"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@nuxt/fonts": "1.1.0",
    "@nuxt/icon": "2.6.0",
    "@nuxt/image": "2.2.0",
    "@nuxt/ui": "4.12.0",
    "@pinia/nuxt": "1.0.3",
    "nuxt": "4.6.2",
    "nuxt-security": "2.7.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^9.0.4",
    "orval": "^8.44.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true
  }
}
